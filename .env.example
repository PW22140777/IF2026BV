# Copia este archivo como .env y cambia los valores antes de usarlo en serio.
#   cp .env.example .env

# Este equipo trabaja contra una base compartida en Supabase (ver abajo),
# así que el Postgres local no se usa y no hace falta activarlo.
# Si alguna vez quieres uno local, descomenta estas líneas y arranca con:
#   docker compose --profile local-db up --build
# COMPOSE_PROFILES=local-db
# POSTGRES_DB=escuela
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=cambia-postgres
# DB_PASS_AUTH=cambia-auth
# DB_PASS_INMUEBLES=cambia-inmuebles
# DB_PASS_SERVICIOS=cambia-servicios
# DB_PASS_AUDIT=cambia-audit

# ----- Base de datos compartida en Supabase (la que usa este equipo).
# Pide al administrador de la base la cadena de conexión de cada rol y pégala
# aquí solo en tu .env local (nunca la subas a git). Usa el modo transacción
# del pooler (puerto 6543): en el modo sesión (5432) cada conexión abierta de
# cada integrante ocupa una de las 15 del pool, y se agotan con dos o tres
# sistemas levantados. Empieza con postgresql+psycopg:// porque SQLAlchemy no
# acepta el prefijo postgres:// que muestra Supabase:
# postgresql+psycopg://<rol>_svc.<proyecto>:<password>@<host-del-pooler>:6543/postgres?sslmode=require
# DATABASE_URL_AUTH=
# DATABASE_URL_INMUEBLES=
# DATABASE_URL_SERVICIOS=
# DATABASE_URL_AUDIT=

# ----- Conexiones de cada servicio a la base (4 servicios: hasta 4 x (pool + extra))
# Con la base local bastan los valores por defecto (5 y 5: hasta 40 conexiones).
# Con la base compartida usa 1 y 2: cada sistema abre como máximo 12.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ----- JWT: usa una cadena larga y aleatoria, p. ej.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# ----- Sesiones: se cierran tras 30 min sin actividad y, como máximo, 4 h después de entrar
SESION_INACTIVIDAD_MINUTOS=30
SESION_MAXIMA_HORAS=4

# ----- RabbitMQ
RABBITMQ_USER=escuela
RABBITMQ_PASSWORD=cambia-rabbit

# ----- Primer administrador (se crea solo si la tabla de usuarios está vacía)
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@escuela.mx
ADMIN_PASSWORD=Admin12345
# Crea también tecnico@escuela.mx / Tecnico12345 y consulta@escuela.mx / Consulta12345
CREAR_USUARIOS_DEMO=true

# ----- Grafana
GRAFANA_PASSWORD=cambia-grafana

# ----- Límites del gateway (peticiones por minuto por IP)
LIMITE_LOGIN_POR_MINUTO=5
LIMITE_API_POR_MINUTO=300
